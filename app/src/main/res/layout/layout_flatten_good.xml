<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#C8E6C9"
    android:padding="20dp">

    <TextView android:id="@+id/lbl" android:text="GOOD: Flat RelativeLayout" android:textStyle="bold" android:layout_marginBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_below="@id/lbl"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@mipmap/ic_launcher"/>

    <TextView
        android:id="@+id/tvName"
        android:layout_toEndOf="@id/imgAvatar"
        android:layout_alignTop="@id/imgAvatar"
        android:layout_marginStart="10dp"
        android:text="User Name"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnFollow"
        android:layout_toEndOf="@id/imgAvatar"
        android:layout_below="@id/tvName"
        android:layout_marginStart="10dp"
        android:text="Follow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_toEndOf="@id/btnFollow"
        android:layout_alignBaseline="@id/btnFollow"
        android:layout_marginStart="10dp"
        android:text="10 min ago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</RelativeLayout>