<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#202020">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEMO TỐI ƯU ĐỒ HỌA"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnScenarioCpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kịch bản 1: CPU (Batching vs Loop)"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnScenarioGpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kịch bản 2: GPU (Shader Complexity)"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnScenarioTexture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kịch bản 3: Texture Compression"
        android:padding="16dp"/>

</LinearLayout>